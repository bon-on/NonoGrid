+    ], reason: 'an open tutorial stays stopped after resume');
+    await tester.sendKeyEvent(LogicalKeyboardKey.escape);
+    await tester.pump();
+    expect(platform.events, ['start', 'stop', 'start', 'stop', 'start']);
